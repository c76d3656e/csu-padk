{
  // GitHub Codespaces / VS Code Dev Containers 配置。
  //
  // 这里的全部作用就是让「点一下 badge」等价于「本地把项目跑起来」：
  //   1. postCreateCommand 装依赖 + 构建（dist/ 是服务端与静态资源的共同前提）
  //   2. postStartCommand 在每次容器启动时拉起本机服务（端口 5173，与本地一致）
  //   3. forwardPorts + portsAttributes 把 5173 公开成 HTTPS 地址，点开即用
  //
  // 注意：本机服务需要在容器里持续运行，所以这个环境不适合当「部署」用 ——
  // 免费额度耗尽或闲置 30 分钟就会停。真正长期可用的形态是 exe 或云端三种。
  "name": "csu-padk",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",

  "postCreateCommand": "npm ci && npm run build",

  // nohup + 重定向：后台跑，且不把 stdout 挂在容器初始化进程上
  // （不重定向的话 devcontainer 会等这个管道关闭，容器就一直卡在启动中）
  "postStartCommand": "nohup npm start > /tmp/padk.log 2>&1 &",

  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": {
      "label": "csu-padk",
      "onAutoForward": "openPreview"
    }
  }
}
