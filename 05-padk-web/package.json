{
  "name": "csu-padk-panel",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "中南大学智慧学工 · 平安打卡面板（纯前端，零后端）",
  "scripts": {
    "start": "node server.mjs",
    "dev": "vite",
    "build": "tsc -b --noCheck && vite build && vite build --config vite.inject.config.ts && node scripts/merge.mjs",
    "build:web": "vite build",
    "build:inject": "vite build --config vite.inject.config.ts",
    "build:exe": "node scripts/build-exe.mjs",
    "deploy": "node scripts/deploy-pages.mjs",
    "preview": "vite preview --port 4173"
  },
  "dependencies": {
    "crypto-js": "^4.2.0",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "postject": "^1.0.0-alpha.6",
    "puppeteer-core": "^25.10.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
